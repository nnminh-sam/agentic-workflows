#!/bin/sh
# .githooks/{{.Name}} — generated by mygit; logic lives in `mygit hook`
if ! command -v mygit >/dev/null 2>&1; then
  echo {{shq (printf "mygit: not on PATH, skipping the %s hook (rules not checked)." .Name)}} >&2
  echo {{shq (printf "  install: %s" .InstallHint)}} >&2
  exit 0
fi
exec mygit hook {{.Name}} "$@"
