#!/bin/sh
# my-git commit message rules: Conventional Commits header, no AI co-author / attribution.
# Generated by my-git setup_repo.py.

msg_file="$1"
header=$(grep -v '^#' "$msg_file" | sed -n '/[^[:space:]]/{p;q;}')

case "$header" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) ;;
  *)
    if ! printf '%s\n' "$header" | grep -Eq '^({{TYPES}})(\([a-z0-9][a-z0-9._/-]*\))?!?: .{3,}$'; then
      echo "commit-msg: header must be '<type>(<scope>)!: <subject>' with type one of: {{TYPES_LIST}}" >&2
      echo "  got: $header" >&2
      exit 1
    fi
    if [ "${#header}" -gt 72 ]; then
      echo "commit-msg: header is ${#header} chars, max 72" >&2
      exit 1
    fi ;;
esac

if grep -v '^#' "$msg_file" | grep -Eiq '^(co-authored-by|assisted-by|generated-by|ai-assisted):.*(claude|anthropic|openai|chatgpt|gpt-?[0-9]|codex|copilot|gemini|cursor|devin|aider|windsurf|codeium|llm|noreply@anthropic\.com)'; then
  echo "commit-msg: AI co-author trailers are not allowed; remove the Co-Authored-By line." >&2
  exit 1
fi
if grep -v '^#' "$msg_file" | grep -Eiq '(generated (with|by) .*(claude|chatgpt|copilot|gemini|cursor|codex|llm))|🤖'; then
  echo "commit-msg: AI attribution lines ('Generated with ...') are not allowed." >&2
  exit 1
fi
exit 0
