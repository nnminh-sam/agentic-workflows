#!/bin/sh
# my-git branching model: {{PRODUCTION}} and {{STAGING}} only change through pull requests.
# The very first push of each (bootstrap) is allowed.
# Generated by my-git setup_repo.py.

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "refs/heads/{{PRODUCTION}}"|"refs/heads/{{STAGING}}")
      name=${remote_ref#refs/heads/}
      if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: deleting protected branch '$name' is blocked." >&2
        status=1
      elif [ "$remote_sha" = "$zero" ]; then
        echo "pre-push: publishing protected branch '$name' for the first time (bootstrap)." >&2
      else
        echo "pre-push: direct push to protected branch '$name' is blocked; open a pull request." >&2
        status=1
      fi ;;
  esac
done
exit $status
