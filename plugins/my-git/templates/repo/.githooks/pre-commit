#!/bin/sh
# my-git branching model: no direct commits on {{PRODUCTION}} / {{STAGING}};
# work branches must be named like {{BRANCH_EXAMPLE}}.
# Generated by my-git setup_repo.py. Enable with: git config core.hooksPath .githooks

git rev-parse -q --verify HEAD >/dev/null 2>&1 || exit 0   # very first commit of the repo
branch=$(git symbolic-ref --short -q HEAD) || exit 0         # detached HEAD (rebase etc.)

case "$branch" in
  "{{PRODUCTION}}"|"{{STAGING}}")
    echo "pre-commit: direct commits to '$branch' are blocked." >&2
    echo "  Create a work branch: git switch -c {{BRANCH_EXAMPLE}} {{STAGING}}" >&2
    echo "  and merge through a pull request." >&2
    exit 1 ;;
esac

if ! printf '%s\n' "$branch" | grep -Eq '{{BRANCH_PATTERN}}'; then
  echo "pre-commit: branch '$branch' does not match {{BRANCH_PATTERN}}" >&2
  echo "  Rename it: git branch -m {{BRANCH_EXAMPLE}}" >&2
  exit 1
fi
exit 0
