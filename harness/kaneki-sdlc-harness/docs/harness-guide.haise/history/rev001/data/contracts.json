          "name": "id, description",
          "type": "string",
          "req": true,
          "meaning": "identity"
        },
        {
          "name": "tracker: fetch {command?, instructions}, reply, kindHints?",
          "type": "object",
          "req": true,
          "meaning": "how to pull a ticket and post a reply"
