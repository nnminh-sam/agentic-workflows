  "description": "Every contract in the harness: shape, writer, reader, enforcement",
  "data": [
    {
      "id": "project-profile",
      "name": "Project profile",
      "schemaId": "sdlc-project-profile@1",
      "file": "`contracts/project-profile.schema.json` · instance `sdlc.profile.json`",
      "writer": "You (once per project)",
      "reader": "driver (every command), units via plan/packet",
      "enforced": "partial",
      "enforcedNote": "`harness/profile.py` `validate_profile` checks required keys, tiers, repo fields, testcase format and that every surface has an evidence entry; it does not enforce `additionalProperties: false` or types.",
      "fields": [
        {
          "name": "schemaVersion",
          "type": "1",
          "req": true,
          "meaning": "contract version"
        },
        {
          "name": "project",
          "type": "{id, name, description?}",
          "req": true,
          "meaning": "identity"
        },
        {
          "name": "locale",
          "type": "{chat, artifacts, tracker, review}",
          "req": false,
          "meaning": "language per audience"
        },
        {
          "name": "paths.ticketRoot",
          "type": "string",
          "req": true,
          "meaning": "ticket directories root, relative to the profile file"
        },
        {
          "name": "paths.branchPrefix",
          "type": "string",
          "req": false,
          "meaning": "branch name prefix for worktrees"
        },
        {
          "name": "models",
          "type": "{routine, deep}",
          "req": true,
          "meaning": "model per capability tier"
        },
        {
          "name": "tracker",
          "type": "{adapter, config?}",
          "req": true,
          "meaning": "tracker adapter id/path + its config"
        },
        {
          "name": "repositories[]",
          "type": "{id, path, stack, surfaces[], defaultBranch?, remote?}",
          "req": true,
          "meaning": "each repo the harness may read/change"
        },
        {
          "name": "rulepacks[]",
          "type": "string",
          "req": true,
          "meaning": "bundled pack ids or paths; stack packs load automatically"
        },
        {
          "name": "testcase",
          "type": "{format, template?, helper?}",
          "req": true,
          "meaning": "markdown | xlsx | csv | gherkin"
        },
        {
          "name": "evidence.surfaces",
          "type": "map surface → {adapter, reason?, config?}",
          "req": true,
          "meaning": "runner per surface; adapter `none` opts out"
        },
        {
          "name": "delivery",
          "type": "{adapter, drafts[], receiptTtlHours?, minHoursLeft?, config?}",
          "req": true,
          "meaning": "drafts to write and receipt timing"
        },
        {
          "name": "families[]",
          "type": "{id, nodes?, rulepack?}",
          "req": false,
          "meaning": "capability families: extension nodes + rules"
        },
        {
          "name": "gates",
          "type": "{loopCap?, autoSkipPlanApproval?}",
          "req": false,
          "meaning": "loop cap (default 2), plan auto-approval"
        },
        {
          "name": "environment",
          "type": "{doctor[]?, sharedState[]?}",
          "req": false,
          "meaning": "extra doctor commands; resources whose mutation needs G6"
        }
      ],
      "cites": [
        "src-profile-schema",
        "src-ticketroot"
      ]
    },
    {
      "id": "adapter",
