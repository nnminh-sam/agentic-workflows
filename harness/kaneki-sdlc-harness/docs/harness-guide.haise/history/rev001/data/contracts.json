        },
        {
          "name": "verdict",
          "type": "PASS | FAIL | APPROVED | NEEDS CHANGES",
          "req": false,
          "meaning": "a last reviewer FAIL blocks the gate"
        },
        {
          "name": "failureClass",
          "type": "record | artifact",
          "req": false,
          "meaning": "reviewer FAIL type"
        },
        {
          "name": "at",
          "type": "ISO time",
          "req": true,
          "meaning": ""
        }
      ],
      "cites": [
        "src-record"
      ]
    },
