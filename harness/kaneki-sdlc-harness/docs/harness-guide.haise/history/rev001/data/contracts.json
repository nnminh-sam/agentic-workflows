          "type": "string",
          "req": true,
          "meaning": "what to verify, decidable from evidence"
        },
        {
          "name": "rules[].appliesTo",
          "type": "{kinds?, stacks?, surfaces?, families?}",
          "req": false,
          "meaning": "filter against the ticket context"
        }
      ],
      "cites": [
        "src-rulepack-schema"
      ]
    },
