        {
          "name": "delivery: drafts {name → {template}}, review, ship {requiresUserGo: true, steps}, reship",
          "type": "object",
          "req": true,
          "meaning": "drafts, PR review fetch, ship steps"
        }
      ],
      "cites": [
        "src-adapter-schema"
      ]
    },
    {
