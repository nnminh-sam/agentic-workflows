          "req": true,
          "meaning": "planned unit id or `reviewer`"
        },
        {
          "name": "generation",
          "type": "int",
          "req": true,
          "meaning": "the node generation it belongs to"
        },
        {
          "name": "model",
          "type": "string",
          "req": true,
          "meaning": "must equal `models[tier]`"
        },
        {
          "name": "status",
          "type": "ok | blocked | partial",
          "req": true,
          "meaning": "gate needs `ok` for every planned unit"
        },
        {
          "name": "result, resultDigest",
          "type": "path, sha256",
          "req": true,
          "meaning": "pins the exact result file"
        },
        {
          "name": "tokens",
          "type": "int | null",
          "req": false,
