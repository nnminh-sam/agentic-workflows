    {
      "id": "packet",
      "name": "Dispatch packet",
      "schemaId": "template",
      "file": "`packets/<node>.g<G>.<unit>.r<R>.md` + `.rules.json`",
      "writer": "driver `packet` from `scripts/packet-template.md`",
      "reader": "unit subagent (after checking sha256)",
      "enforced": "driver renders; agent verifies digest",
      "enforcedNote": "Placeholders are filled from the plan, profile, adapters and facts JSON; the rules file is the node's selected rules.",
      "fields": [
        {
          "name": "Unit contract",
          "type": "section",
          "req": true,
          "meaning": "node, unit, role, purpose, card path, artifact language"
        },
        {
          "name": "Role limits / Forbidden actions / Evidence discipline",
          "type": "section",
          "req": true,
          "meaning": "same for every dispatch"
        },
        {
          "name": "Return contract",
          "type": "section",
          "req": true,
          "meaning": "result file shape + ≤150-word reply"
        },
        {
          "name": "Dispatch facts",
          "type": "section",
          "req": true,
          "meaning": "ticket, generation, round, dispatch id, result path, artifacts, repositories, rules path, adapter files"
        },
        {
          "name": "Authorized paths · Weakest claim · Observed · Doubts · Settled · Findings to fix",
          "type": "sections",
          "req": true,
          "meaning": "from the facts JSON"
        },
        {
          "name": "<dispatch>.rules.json",
          "type": "rule[] + pack",
          "req": true,
          "meaning": "rules for this node's `rulePhases`, filtered by `appliesTo`"
        }
      ],
      "cites": [
        "src-dispatch-id",
        "src-template-return"
      ]
    },
    {
      "id": "result-file",
      "name": "Unit result file",
      "schemaId": "— (prose contract)",
      "file": "`results/<node>.g<G>.<unit>.r<R>.md`",
      "writer": "unit",
      "reader": "controller (verify), reviewer unit, driver (digest only)",
      "enforced": "existence + digest",
      "enforcedNote": "The driver never parses it; the verdict is what the controller passes to `record --verdict`.",
      "fields": [
        {
          "name": "worker: status · claims (OBSERVED/DERIVED/ASSUMED) · evidence pointers · artifact paths · checks · doubts (HIGH/LOW) · weakest link",
          "type": "markdown",
          "req": true,
          "meaning": ""
        },
        {
          "name": "reviewer: verdict PASS/FAIL · failure class · blocking findings · uncovered rules/units · weakest link",
          "type": "markdown",
          "req": true,
          "meaning": ""
        }
      ],
      "cites": [
        "src-template-return"
      ]
    },
    {
      "id": "node-artifact",
      "name": "Node artifacts",
      "schemaId": "— (card contract)",
      "file": "ticket dir: `plan.md`, `investigation.md`, `drafts/<name>.md`…",
      "writer": "the node's worker unit",
      "reader": "later units, reviewers, the user",
      "enforced": "existence only",
      "enforcedNote": "Required sections are defined in each node card (e.g. `## Condition → negative case` in plan.md) but the gate checks only that the file exists.",
      "fields": [
        {
          "name": "file names",
          "type": "from `artifacts[]`",
          "req": true,
          "meaning": "`@delivery.drafts` expands to `drafts/<name>.md` per profile draft"
        },
        {
          "name": "sections",
          "type": "from the node card",
          "req": true,
          "meaning": "e.g. `## Confirmed cause` + `Confidence:` in investigation.md"
        }
      ],
      "cites": [
        "src-artifacts-expand",
        "src-absent"
      ]
    }
  ]
}