{
  "schemaVersion": 1,
  "graphId": "sdlc-lifecycle@1",
  "description": "Generic ticket lifecycle. Layers 1-2 (analysis, implementation) port wms-flow almost 1:1; layers 3-4 keep only the generic delivery and after-PR nodes. Project specifics come from the project profile and adapters, never from this file. Each node's `checks` names the sections and parsers its gate verifies on the live text of each artifact. `lanes` picks a shorter trace for small changes: a lane with its own `order` replaces the main order; nodes in its `inline` list are done by the controller itself (no subagent). Tiers: `light` (optional profile model, falls back to routine) codes from the approved plan and does intake and drafts; `routine` analyses, writes and reviews test cases, does the technical review and the evidence; `deep` diagnoses, plans and does the semantic review, which runs only after the technical review passed. The `learning` layer's reflect node closes the trace: it requires `release-ready` (and `review-reply` in a review round, a token no node produces in a first delivery), so ship never depends on it.",
  "layers": [
    {
      "id": "analysis",
      "label": "Analysis · bug (investigate) or feature (requirement)"
    },
    {
      "id": "implementation",
      "label": "Implementation and review"
    },
    {
      "id": "delivery",
      "label": "Verification and delivery"
    },
    {
      "id": "after-pr",
      "label": "After PR · review-fix (reuses the main graph through reopen)"
    },
    {
      "id": "learning",
      "label": "Learning · reflect on what went wrong and propose lessons (never blocks ship)"
    }
  ],
  "order": [
    "prepare",
    "investigate",
    "fix-plan",
    "requirement-analysis",
    "impact-analysis",
    "feature-plan",
    "coding",
    "code-review",
    "@slot:after-code-review",
    "testcase",
    "testcase-review",
    "execute-and-evidence",
    "@slot:after-evidence",
    "final-review",
    "delivery-drafts",
    "deliverable-ready",
    "read-review",
    "triage-review",
    "respond-review",
    "reflect"
  ],
  "lanes": {
    "full": {
      "description": "Every node of the graph: analysis, approved plan, worktree, staged code review (technical on routine, semantic on deep), test cases, real-surface evidence, final review. For bugs with an unknown cause, features, shared flows, data/API/schema changes."
    },
    "lite": {
      "description": "Small, well-understood change (e.g. a CSS or copy tweak): scope (approved by the user) -> change in place -> one quick review -> drafts -> deliverable-ready. No worktree, no test-case documents, no surface evidence, no deep tier, no families. Escalate with `sdlc lane --set full`.",
      "order": [
        "scope",
        "change",
        "check",
        "delivery-drafts",
        "deliverable-ready",
        "read-review",
        "triage-review",
        "respond-review",
        "reflect"
      ],
      "inline": [
        "delivery-drafts",
        "read-review"
      ],
      "inPlace": true
    }
  },
  "nodes": {
    "prepare": {
      "layer": "analysis",
      "purpose": "Fetch the ticket through the tracker adapter, resolve repositories, stacks and surfaces from the profile, create the worktree, run the environment doctor.",
      "requires": [],
      "produces": [
        "context",
        "environment",
        "ticket-authority"
      ],
      "mutability": "state",
      "units": [
        {
          "id": "worker",
          "role": "worker",
          "tier": "light"
        }
      ],
      "boundary": "controller",
      "gates": [
        "G7"
      ],
      "artifacts": [
        "ticket.md",
        "environment.md"
      ],
      "card": "references/nodes/prepare.md",
      "checks": {
        "environment.md": {
          "sections": [
            "## Repositories",
            "## Doctor",
            "## Surfaces"
          ]
        }
      }
    },
    "investigate": {
      "layer": "analysis",
