      ],
      "mutability": "artifacts",
      "units": [
        {
          "id": "worker",
          "role": "worker",
          "tier": "deep"
        }
      ],
      "boundary": "controller",
      "gates": [
        "G1",
        "G7"
      ],
      "artifacts": [
        "investigation.md"
      ],
      "optionalArtifacts": [
        "questions.md"
      ],
      "card": "references/nodes/investigate.md",
      "checks": {
