      "purpose": "Lite lane. One routine reviewer reads the real diff against the scope and the code rules, reruns the checks, and gives a verdict. NEEDS CHANGES reopens change. Closing issues the receipts kaneki-ship needs.",
      "requires": [
        "approved-plan",
        "source-change"
      ],
      "produces": [
        "code-reviewed",
        "evidence",
        "receipts"
      ],
      "mutability": "findings-only",
      "units": [
        {
          "id": "quick-review",
