          "role": "worker",
          "tier": "deep"
        }
      ],
      "boundary": "user",
      "gates": [
        "G3"
      ],
      "rulePhases": [
        "design"
      ],
      "artifacts": [
        "plan.md"
      ],
      "card": "references/nodes/fix-plan.md",
      "checks": {
        "plan.md": {
          "sections": [
