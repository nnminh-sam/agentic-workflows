    "code-review": {
      "layer": "implementation",
      "purpose": "Staged review over the real diff. technical-review (routine) builds, lints, tests, runs the app and judges every code-phase rule; only on its PASS does semantic-review (deep) check plan conformance, negative cases and the weakest claim on the running app. Either FAIL reopens coding; a fix round reviews only the fix.",
      "requires": [
        "source-change"
      ],
      "produces": [
        "code-reviewed"
      ],
      "mutability": "findings-only",
      "units": [
        {
          "id": "technical-review",
          "role": "worker",
          "tier": "routine"
        },
        {
          "id": "semantic-review",
          "role": "worker",
          "tier": "deep",
          "after": "technical-review"
        }
      ],
      "pattern": "staged-units-controller-judged",
      "boundary": "controller",
      "gates": [
        "G4"
      ],
      "loopBackTo": "coding",
      "rulePhases": [
        "code"
      ],
      "artifacts": [
        "code-review.md"
      ],
      "card": "references/nodes/code-review.md",
      "checks": {
