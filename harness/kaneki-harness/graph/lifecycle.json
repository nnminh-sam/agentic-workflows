    "reflect": {
      "layer": "learning",
      "when": {
        "reflect": true
      },
      "purpose": "Read the ticket's signals (loop-backs, invalidations, escalations, gate firings, answered HIGH questions, accepted PR findings) and write a cited reflection plus proposals (lessons, rules, profile or harness changes). Proposals change nothing until the user approves them (D10). Ship never waits for this node. With learning.reflect on-signal (default) and no new signal, the driver closes it without a unit.",
      "requires": [
        "release-ready",
        "review-reply"
      ],
      "produces": [
        "reflection"
      ],
      "mutability": "artifacts",
      "units": [
        {
          "id": "worker",
          "role": "worker",
          "tier": "routine"
        }
      ],
      "boundary": "controller",
      "gates": [],
      "artifacts": [
        "reflection.md",
        "proposals.json"
      ],
      "card": "references/nodes/reflect.md",
      "checks": {
        "reflection.md": {
          "sections": [
            "## Signals",
            "## Causes",
            "## Proposals"
          ]
        },
        "proposals.json": {
          "parsers": [
            "proposals"
          ]
        }
      }
    }
  },
  "gates": {
    "G0": "Node boundary record. 'user' boundary nodes ask Proceed / Re-run / Stop; others are recorded by the controller.",
    "G1": "Analysis doubt: missing authority source, unconfirmed assumptions, or cause/requirement confidence below High.",
    "G3": "Materially different options, or a shared/standard flow is changed.",
    "G4": "NEEDS CHANGES remains after the loop cap (profile gates.loopCap, default 2).",
    "G5": "Test or rule applicability / expected value is ambiguous.",
    "G6": "Shared-state mutation, real device/hardware, missing runtime config, or ambiguous result.",
    "G7": "Missing or unsafe prerequisite: file, path, adapter, tool, permission, model, or supervision evidence.",
    "G8": "Budget: a profile budgets cap (ticket, node or local day) is reached. sdlc packet refuses and the runner parks or stops the node; proceed by raising the cap or by the user's one-node override (sdlc budget --allow-node --actor user)."
  }
}
