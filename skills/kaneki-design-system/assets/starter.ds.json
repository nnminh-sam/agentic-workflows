      { "title": "Sizes", "tokens": [
        { "name": "control-h", "value": "32px", "usage": "Height of buttons and inputs." },
        { "name": "control-h-sm", "value": "26px", "usage": "Small buttons." }
      ] }
    ]
  },
  "contrast": [
    { "fg": "ink", "bg": "surface", "min": 4.5 },
    { "fg": "ink", "bg": "canvas", "min": 4.5 },
    { "fg": "ink-2", "bg": "surface", "min": 4.5 },
    { "fg": "on-accent", "bg": "accent", "min": 4.5, "note": "Primary button label." },
    { "fg": "ok-text", "bg": "ok-soft", "min": 4.5 },
    { "fg": "bad-text", "bg": "bad-soft", "min": 4.5 },
    { "fg": "on-bad", "bg": "bad", "min": 4.5 },
    { "fg": "border-strong", "bg": "surface", "min": 3, "note": "Non-text: control borders (WCAG 1.4.11)." }
  ],
  "icons": {
    "className": "ds-icon",
    "viewBox": "0 0 24 24",
    "attrs": { "fill": "none", "stroke": "currentColor", "stroke-width": "1.75", "stroke-linecap": "round", "stroke-linejoin": "round" },
    "set": {
      "plus": "<path d=\"M12 5v14M5 12h14\"/>",
      "check": "<path d=\"m5 12.5 4.5 4.5L19 7.5\"/>",
      "x": "<path d=\"M6 6l12 12M18 6 6 18\"/>",
      "alert": "<path d=\"M12 4 2.8 19.5h18.4z\"/><path d=\"M12 10v4M12 17h.01\"/>",
      "info": "<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 11v5M12 8h.01\"/>",
      "trash": "<path d=\"M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12\"/>",
      "search": "<circle cx=\"11\" cy=\"11\" r=\"6\"/><path d=\"m20 20-4.5-4.5\"/>"
    }
  },
  "components": [
    {
      "id": "button", "group": "Actions", "name": "Button", "status": "Stable",
      "classes": [
        { "name": "ds-btn", "use": "Base: secondary button." },
        { "name": "ds-btn--primary", "use": "The one next step in a view." },
        { "name": "ds-btn--danger", "use": "Deletes or discards work." },
        { "name": "ds-btn--ghost", "use": "Low-emphasis: Cancel, toolbar actions." },
        { "name": "ds-btn--sm", "use": "Dense rows and toolbars." }
      ],
      "desc": "Starts an action. One primary button per view: the next step the user is most likely to take.",
      "examples": [
        { "title": "Variants", "html": "<div class=\"dsg-row\">\n  <button class=\"ds-btn ds-btn--primary\">{{icon:plus}}New project</button>\n  <button class=\"ds-btn\">Export</button>\n  <button class=\"ds-btn ds-btn--danger\">{{icon:trash}}Delete</button>\n  <button class=\"ds-btn ds-btn--ghost\">Cancel</button>\n</div>" },
        { "title": "States", "note": "States are shown with state classes so they can be compared side by side.", "html": "<div class=\"dsg-row\">\n  <button class=\"ds-btn ds-btn--primary\">Rest</button>\n  <button class=\"ds-btn ds-btn--primary is-hover\">Hover</button>\n  <button class=\"ds-btn ds-btn--primary is-focus\">Focus</button>\n  <button class=\"ds-btn ds-btn--primary\" disabled>Disabled</button>\n</div>\n<div class=\"dsg-row\">\n  <button class=\"ds-btn ds-btn--sm\">Small</button>\n  <button class=\"ds-btn ds-btn--sm ds-btn--primary\">Small primary</button>\n</div>" }
      ],
      "dos": ["Name the action with a verb and its object: \"New project\", \"Delete file\"."],
      "donts": ["Two primary buttons side by side.", "A danger button without a confirmation step."],
      "a11y": ["Use a real <code>&lt;button&gt;</code>; the focus ring must stay visible (3:1 against the page)."]
    },
    {
      "id": "badge", "group": "Feedback", "name": "Badge", "status": "Stable",
      "classes": ["ds-badge", "ds-badge--ok", "ds-badge--bad"],
      "desc": "A short status label next to the thing it describes.",
      "examples": [
        { "title": "Tones", "html": "<div class=\"dsg-row\">\n  <span class=\"ds-badge\">Draft</span>\n  <span class=\"ds-badge ds-badge--ok\">{{icon:check}}Passed</span>\n  <span class=\"ds-badge ds-badge--bad\">{{icon:x}}Failed</span>\n</div>" }
      ],
      "dos": ["One or two words."],
      "donts": ["Colour as the only signal: pair the tone with a word or icon."]
    },
    {
      "id": "alert", "group": "Feedback", "name": "Alert", "status": "Beta",
      "classes": ["ds-alert", "ds-alert--ok", "ds-alert--bad", "ds-alert__title"],
      "desc": "An inline message about the content around it.",
      "examples": [
        { "title": "Tones", "html": "<div class=\"dsg-stack\">\n  <div class=\"ds-alert\" role=\"status\">{{icon:info}}<div><p class=\"ds-alert__title\">Sync paused</p>Changes are kept locally until you reconnect.</div></div>\n  <div class=\"ds-alert ds-alert--bad\" role=\"alert\">{{icon:alert}}<div><p class=\"ds-alert__title\">Upload failed</p>The file is larger than 20 MB.</div></div>\n</div>" }
      ],
      "dos": ["Say what happened and what to do next."],
      "donts": ["Alerts for things that need no action."]
    },
    {
      "id": "field", "group": "Inputs", "name": "Text field", "status": "Stable",
      "classes": ["ds-field", "ds-field__label", "ds-input", "ds-field__hint", "is-invalid"],
      "desc": "A labelled single-line input with an optional hint or error.",
      "examples": [
        { "title": "States", "html": "<div class=\"dsg-grid\">\n  <label class=\"ds-field\"><span class=\"ds-field__label\">Project name</span><input class=\"ds-input\" value=\"Atlas\"><span class=\"ds-field__hint\">Shown in the sidebar.</span></label>\n  <label class=\"ds-field is-invalid\"><span class=\"ds-field__label\">Slug</span><input class=\"ds-input\" value=\"Atlas Web\" aria-invalid=\"true\"><span class=\"ds-field__hint\">Use lowercase letters and dashes.</span></label>\n</div>" }
      ],
      "dos": ["Keep the label visible; placeholders are examples, not labels."],
      "donts": ["Validate while the user is still typing the first time."]
    },
    {
      "id": "card", "group": "Layout", "name": "Card", "status": "Stable",
      "classes": ["ds-card", "ds-card__title", "ds-card__body", "ds-card__footer"],
      "desc": "Groups content about one thing on a raised surface.",
      "examples": [
        { "title": "With actions", "html": "<div class=\"ds-card\" style=\"max-width:360px\">\n  <h3 class=\"ds-card__title\">Atlas Web</h3>\n  <p class=\"ds-card__body\">Last deployed 2026-11-20 · 3 open issues</p>\n  <div class=\"ds-card__footer\"><button class=\"ds-btn ds-btn--ghost ds-btn--sm\">Settings</button><button class=\"ds-btn ds-btn--primary ds-btn--sm\">Open</button></div>\n</div>" }
      ],
      "dos": ["One subject per card."],
      "donts": ["Cards inside cards."]
    }
  ],
  "screens": [
    {
      "id": "projects", "name": "Projects page", "summary": "Card grid with a page title and one primary action.", "status": "Draft",
      "desc": "How the pieces combine on a real page.",
      "uses": ["button", "card", "badge", "alert"],
      "html": "<div style=\"display:grid;gap:var(--space-4);padding:var(--space-6);background:var(--canvas);border:1px solid var(--border);border-radius:var(--radius-lg)\">\n  <div class=\"dsg-row\"><h1 class=\"ds-title\" style=\"margin:0\">Projects</h1><span style=\"flex:1\"></span><button class=\"ds-btn ds-btn--primary\">{{icon:plus}}New project</button></div>\n  <div class=\"ds-alert\" role=\"status\">{{icon:info}}<div><p class=\"ds-alert__title\">Sync paused</p>Changes are kept locally until you reconnect.</div></div>\n  <div class=\"dsg-grid\">\n    <div class=\"ds-card\"><h3 class=\"ds-card__title\">Atlas Web <span class=\"ds-badge ds-badge--ok\">Live</span></h3><p class=\"ds-card__body\">Last deployed 2026-11-20</p></div>\n    <div class=\"ds-card\"><h3 class=\"ds-card__title\">Atlas API <span class=\"ds-badge ds-badge--bad\">Failing</span></h3><p class=\"ds-card__body\">Build 418 failed</p></div>\n    <div class=\"ds-card\"><h3 class=\"ds-card__title\">Docs <span class=\"ds-badge\">Draft</span></h3><p class=\"ds-card__body\">Not published</p></div>\n  </div>\n</div>"
    }
  ]
}
