      { "name": "shadow-lg", "value": { "light": "0 20px 40px -8px rgba(16,24,40,0.18)", "dark": "0 20px 40px -8px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.05)" }, "usage": "Dialogs and menus floating above the page." }
    ],
    "fonts": [
      { "name": "font-text", "value": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, Roboto, sans-serif", "usage": "All UI text." },
      { "name": "font-mono", "value": "\"Cascadia Mono\", Consolas, ui-monospace, monospace", "usage": "Code, IDs, anything you could paste into a terminal." }
    ],
    "type": [
      { "name": "title", "family": "{font-text}", "size": "24px", "lineHeight": "32px", "weight": 600, "letterSpacing": "-0.3px", "sample": "Account settings", "usage": "Page title, one per view.", "className": "ds-title" },
      { "name": "body", "family": "{font-text}", "size": "14px", "lineHeight": "20px", "weight": 400, "sample": "Changes are saved when you leave the field.", "usage": "Default text." },
      { "name": "code", "family": "{font-mono}", "size": "12px", "lineHeight": "18px", "weight": 400, "sample": "npm run build --prod", "usage": "Inline code and IDs." }
    ],
    "spacing": [
      { "name": "space-1", "value": "4px", "usage": "Icon to label." },
      { "name": "space-2", "value": "8px", "usage": "Between controls in a row." },
      { "name": "space-4", "value": "16px", "usage": "Card padding." },
      { "name": "space-6", "value": "24px", "usage": "Between sections." }
    ],
    "radius": [
      { "name": "radius-sm", "value": "6px", "usage": "Badges, small controls." },
      { "name": "radius-md", "value": "8px", "usage": "Buttons and inputs." },
      { "name": "radius-lg", "value": "12px", "usage": "Cards and dialogs." },
      { "name": "radius-full", "value": "999px", "usage": "Pills." }
    ],
    "motion": [
      { "name": "duration-fast", "value": "120ms", "usage": "Hover and press feedback." },
      { "name": "duration-base", "value": "200ms", "usage": "Panels opening." },
      { "name": "ease-out", "value": "cubic-bezier(0.2, 0, 0, 1)", "usage": "Everything that enters." }
