    "name": "__NAME__",
    "version": "v1",
    "status": "Draft",
    "tagline": "Every component, one at a time",
    "description": "STARTER CONTENT: replace every token, component and screen below with the real system before building for anyone.",
    "date": "__DATE__",
    "lang": "__LANG__",
    "prefix": "ds-",
    "sources": ["Starter scaffold from kaneki-design-system (replace with the files the system was taken from, e.g. <code>src/styles/theme.css</code>)."],
