      { "name": "ink-2", "group": "Text", "value": { "light": "#475467", "dark": "#b3bac6" }, "usage": "Secondary text: descriptions, hints." },
      { "name": "accent", "group": "Accent", "value": { "light": "#2f54d0", "dark": "#7591ff" }, "usage": "Primary button fill, links, focus ring." },
      { "name": "accent-hover", "group": "Accent", "value": { "light": "#2445b8", "dark": "#8aa2ff" }, "usage": "Primary button hover." },
      { "name": "on-accent", "group": "Accent", "value": { "light": "#ffffff", "dark": "#0b0d11" }, "usage": "Text and icons on accent." },
      { "name": "focus", "group": "Accent", "value": "{accent}", "usage": "Focus ring colour (alias of accent)." },
      { "name": "ok", "group": "Status", "value": { "light": "#14855e", "dark": "#3cc796" }, "usage": "Success icon and dot." },
