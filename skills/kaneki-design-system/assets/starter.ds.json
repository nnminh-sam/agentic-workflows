      { "id": "dark", "name": "Dark", "scheme": "dark" }
    ],
    "notes": {
      "colour": "Every colour is a role. Text tokens are checked for 4.5:1 on the grounds their usage names, in both themes.",
      "spacing": "A 4 px grid. Layout gaps use these steps."
    },
    "color": [
      { "name": "canvas", "group": "Surfaces", "value": { "light": "#f5f6f8", "dark": "#0b0d11" }, "usage": "Page ground behind panels." },
      { "name": "surface", "group": "Surfaces", "value": { "light": "#ffffff", "dark": "#121519" }, "usage": "Cards, inputs, menus, dialogs." },
      { "name": "surface-2", "group": "Surfaces", "value": { "light": "#f0f2f5", "dark": "#1c2129" }, "usage": "Hover fill, sunken wells, table headers." },
      { "name": "border", "group": "Surfaces", "value": { "light": "#e4e7ec", "dark": "#252a33" }, "usage": "Hairlines between regions; card borders." },
      { "name": "border-strong", "group": "Surfaces", "value": { "light": "#808a9a", "dark": "#5d6675" }, "usage": "Control borders (inputs, secondary buttons): 3:1 so a field is findable." },
