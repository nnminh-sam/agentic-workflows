      { "name": "bad-soft", "group": "Status", "value": { "light": "#fdeeee", "dark": "#2e1517" }, "usage": "Error badge and alert fill." },
      { "name": "bad-text", "group": "Status", "value": { "light": "#b0222c", "dark": "#ff8f8f" }, "usage": "Error text on bad-soft or surface." },
      { "name": "on-bad", "group": "Status", "value": { "light": "#ffffff", "dark": "#1a0a0b" }, "usage": "Text on a bad fill." }
