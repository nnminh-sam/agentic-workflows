  },
  "principles": [
    { "title": "Colour is a role", "body": "Pick a colour by meaning (<code>bad</code> = destructive or failed), never by looks." },
    { "title": "One primary action", "body": "Each view has at most one primary button: the step the user most likely takes next." }
  ],
