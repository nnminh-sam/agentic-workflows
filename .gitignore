# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/

# Secrets and local env
.env
.env.*
!.env.example
*.local.json

# Claude Code: per-machine state and the kaneki-harness installed copy
# (written by kaneki-harness/harness/install.py, embeds this machine's absolute harnessHome path;
#  the source of truth is kaneki-harness/skills and kaneki-harness/agents)
/.claude/*
!/.claude/settings.json

# Kaneki harness working state (ticket folders, packets, evidence, adapters); may hold customer data
.sdlc/
# workspace-local harness project files: profile (holds git identity), its provenance, local ticket notes
/sdlc.profile.json
/sdlc.profile.evidence.json
/tickets/

# Logs and temp
*.log
.tmp-*
*.tmp

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
